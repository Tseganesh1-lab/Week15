import os
import requests
import smtplib
from email.message import EmailMessage
from datetime import datetime

URL = "https://example.com"
LOG_FILE = "uptime_log.txt"
STATE_FILE = "last_status.txt"


def send_email_alert(url, timestamp, error_message):
    email_user = os.getenv("EMAIL_USER")
    email_pass = os.getenv("EMAIL_PASS")
    email_to = os.getenv("EMAIL_TO")

    if not email_user or not email_pass or not email_to:
        print("Email credentials not found. Please configure your settings.")
        return

    msg = EmailMessage()
    msg["Subject"] = "Website Down Alert"
    msg["From"] = email_user
    msg["To"] = email_to

    msg.set_content(
        f"Website is DOWN.\n\n"
        f"URL: {url}\n"
        f"Time it went down: {timestamp}\n"
        f"Error/Status: {error_message}"
    )

    with smtplib.SMTP_SSL("smtp.gmail.com", 465) as smtp:
        smtp.login(email_user, email_pass)
        smtp.send_message(msg)


def read_last_status():
    if not os.path.exists(STATE_FILE):
        return "ONLINE"

    with open(STATE_FILE, "r") as file:
        return file.read().strip()


def write_last_status(status):
    with open(STATE_FILE, "w") as file:
        file.write(status)


def log_status(timestamp, url, status, details):
    with open(LOG_FILE, "a") as log:
        log.write(f"{timestamp} - {url} - {status} - {details}\n")


def check_website():
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    last_status = read_last_status()

    try:
        response = requests.get(URL, timeout=10)
        status_code = response.status_code

        if 200 <= status_code <= 399:
            current_status = "ONLINE"
            details = f"Status Code: {status_code}"
        else:
            current_status = "DOWN"
            details = f"Status Code: {status_code}"

    except requests.exceptions.RequestException as error:
        current_status = "DOWN"
        details = str(error)

    print(f"{current_status} - {timestamp} - {URL}")
    log_status(timestamp, URL, current_status, details)

    if current_status == "DOWN" and last_status != "DOWN":
        send_email_alert(URL, timestamp, details)

    write_last_status(current_status)


if __name__ == "__main__":
    check_website()