import os
import zipfile
from datetime import datetime

important_folder = "important_files"
backup_folder = "backups"
log_file = "backup_log.txt"

# Task 1: Create backup folder
os.makedirs(backup_folder, exist_ok=True)

# Create timestamped ZIP file name
timestamp = datetime.now().strftime("%Y-%m-%d_%H%M")
zip_filename = f"backup_{timestamp}.zip"
zip_path = os.path.join(backup_folder, zip_filename)

file_count = 0

# Task 2: Zip everything inside important_files/
with zipfile.ZipFile(zip_path, "w") as zip_file:
    for root, folders, files in os.walk(important_folder):
        for file in files:
            file_path = os.path.join(root, file)
            arcname = os.path.relpath(file_path, important_folder)
            zip_file.write(file_path, arcname)
            file_count += 1

# Task 3: Write to log file
log_time = datetime.now().strftime("%Y-%m-%d %H:%M")

with open(log_file, "a") as log:
    log.write(f"{log_time} - Created {zip_path} ({file_count} files)\n")

print(f"Backup created: {zip_path}")
print(f"Files backed up: {file_count}")